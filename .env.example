# Copy to .env and fill in. .env is gitignored.
# Any OpenAI-compatible endpoint works.

# DeepSeek
VERSIONLENS_LLM_API_KEY=
VERSIONLENS_LLM_BASE_URL=https://api.deepseek.com
VERSIONLENS_LLM_MODEL=deepseek-chat

# Groq — use a non-reasoning model; reasoning tokens consume the JSON budget
# VERSIONLENS_LLM_BASE_URL=https://api.groq.com/openai/v1
# VERSIONLENS_LLM_MODEL=llama-3.3-70b-versatile

# OpenAI
# VERSIONLENS_LLM_BASE_URL=
# VERSIONLENS_LLM_MODEL=gpt-4o-mini

# Passages per model call
# VERSIONLENS_LLM_BATCH=8
